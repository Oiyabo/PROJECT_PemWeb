    border: none;
    background: #ffccd5;
    border-radius: 5px;
    cursor: pointer;
}

.reservation-container {
  width: 100%;
  max-width: 980px;
  margin: 0 auto 40px;
  padding: 32px 24px;
}

.step-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 32px;
  padding: 10px;
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 90px;
  padding: 14px 10px;
  border-radius: 14px;
  color: #7b8ba1;
  text-align: center;
  transition: all 0.2s ease;
}

.step-item.active {
  background: var(--accent);
  color: var(--text-dark);
  font-weight: 700;
}

.step-numbers {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.7);
  color: var(--text-dark);
  font-size: 13px;
  font-weight: 700;
}

.step-labels {
  font-size: 13px;
  line-height: 1.4;
}

.reservation-form {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 36px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
}

.form-section {
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.form-title {
  font-size: 24px;
  font-weight: 700;
  color: var(--text-dark);
  margin-bottom: 6px;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-label {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-medium);
}

.required {
  color: #ef4444;
}

.form-input {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid #dbe7f0;
  border-radius: 12px;
  background: #fff;
  color: var(--text-dark);
  font-size: 14px;
  font-family: inherit;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #94a3b8;
}

.form-input:focus {
  outline: none;
  border-color: #76c893;
  box-shadow: 0 0 0 4px rgba(118, 200, 147, 0.15);
}

.form-textarea {
  min-height: 120px;
  resize: vertical;
}

.confirmation-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.confirmation-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding-bottom: 12px;
  border-bottom: 1px dashed #dbe7f0;
}

.confirmation-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.confirmation-item span:first-child {
  font-size: 14px;
  color: var(--text-light);
}

.confirmation-item span:last-child {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-dark);
  text-align: right;
}

.warning-box {
  background: #fff8db;
  border: 1px solid #ffe082;
  border-radius: 12px;
  padding: 14px 16px;
}

.warning-box p {
  margin: 0;
  font-size: 13px;
  color: #7c5c00;
  line-height: 1.5;
}

.form-navigation {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px solid #edf2f7;
}

.btn-primary,
.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 22px;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-primary {
  background: var(--secondary);
  color: white;
}

.btn-primary:hover {
  transform: translateY(-1px);
  opacity: 0.95;
}

.btn-secondary {
  background: #edf6f9;
  color: var(--text-dark);
}

.btn-secondary:hover {
  background: #dfeff3;
}

.service-grid{
    width: 100%;
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 14px;

    margin-top: 15px;
}

.service-item{
    display: flex;
    align-items: center;

    gap: 10px;

    padding: 12px 14px;

    border: 1px solid #dbe4ee;
    border-radius: 10px;

    background: #fff;

    cursor: pointer;

    transition: 0.2s;
}

.service-item:hover{
    border-color: #76c893;
    background: #f8fffb;
}

.service-item input{
    margin: 0;
    flex-shrink: 0;
}

.service-item input[type="checkbox"]{
    accent-color: #76c893;
}

.service-item:has(input:checked){
    border-color: #76c893;
    background: #eafaf0;

    box-shadow: 0 0 0 3px rgba(118, 200, 147, 0.15);
}

.service-text{
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-dark);
}

@media (max-width: 900px){

    .service-grid{
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 600px){

    .service-grid{
        grid-template-columns: 1fr;
    }

}

@media (max-width: 768px) {
  .reservation-container {
    padding: 20px 16px;
  }

  .step-card {
    grid-template-columns: repeat(2, 1fr);
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .reservation-form {
    padding: 24px 20px;
  }

  .form-navigation {
    flex-direction: column-reverse;
  }

  .btn-primary,
  .btn-secondary {
    width: 100%;
  }

  .confirmation-item {
    flex-direction: column;
    align-items: flex-start;
  }

  .confirmation-item span:last-child {
    text-align: left;
  }
}

.popup-overlay{
  position: fixed;
  top:0;
  left:0;
  width:100%;
  height:100%;
  background: rgba(0,0,0,0.5);

  display:none;
  align-items:center;
  justify-content:center;
}

.popup-box{
  background:white;
  padding:25px;
  border-radius:10px;
  width:350px;
  text-align:center;
  box-shadow:0 10px 30px rgba(0,0,0,0.2);
}

.popup-actions{
  margin-top:20px;
  display:flex;
  justify-content:center;
  gap:10px;
}
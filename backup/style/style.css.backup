    gap: 6px;
    padding: 7px 12px;
    border: 1px solid #34a0a4;
    border-radius: 8px;
    background: #fff;
    font-size: 12px;
    color: #1e6091;
}

.input-search input {
    border: none;
    outline: none;
    font-size: 12px;
    background: transparent;
    width: 120px;
}

.table-container {
    background: #fff;
    border: 1px solid #34a0a4;
    border-radius: 12px;
    overflow: hidden;
}

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
}

th {
    background: #f1f5f9;
    padding: 10px;
    font-size: 12px;
    text-align: left;
}

td {
    padding: 10px;
    font-size: 13px;
}

.pelanggan-info {
    display: flex;
    align-items: center;
    gap: 10px;
}

.avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #b5e48c;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
}

.nama {
    font-weight: 600;
    color: #184e77;
    font-size: 13px;
}

.id {
    font-size: 11px;
    color: #52b69a;
}

.icon-text {
    display: flex;
    align-items: center;
    gap: 5px;
    color: #1e6091;
}

.badge {
    padding: 2px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.action-group {
    display: flex;
    gap: 4px;
}

.btn-action {
    padding: 5px;
    border: none;
    background: #e9ecef;
    border-radius: 5px;
    cursor: pointer;
}

.btn-action-danger {
